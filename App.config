<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="CyntecMESEquipment.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <applicationSettings>
        <CyntecMESEquipment.Properties.Settings>
            <setting name="CyntecMESEquipment_serviceEqp_Eqp_Portal" serializeAs="String">
                <value>http://twcynmesWEBQA01/CyntecDataCenter/service/Eqp/Eqp_Portal.asmx</value>
            </setting>
        </CyntecMESEquipment.Properties.Settings>
    </applicationSettings>
    <appSettings>
        <add key="TestMode" value="true" />
    </appSettings>
    <log4net>
        <appender name="RollingFile" type="log4net.Appender.RollingFileAppender">
            <!-- 檔案路徑使用 PatternString 動態產生，包含年月日、LogType 屬性、時 -->
            <file type="log4net.Util.PatternString" value="log\%date{yyyyMMdd}\%property{LogType}\%date{HH}.txt" />
            <appendToFile value="false" />
            <staticLogFileName value="false" />
            <rollingStyle value="Date" />
            <datePattern value="yyyyMMdd-HH" /> <!-- 這裡其實是輔助觸發切換，實際路徑由 file 決定 -->
            <layout type="log4net.Layout.PatternLayout">
                <conversionPattern value="[%date{yyyy-MM-dd HH:mm:ss.fff}] [%property{LogType}] %message%newline" />
            </layout>
        </appender>
        <root>
            <level value="ALL" />
            <appender-ref ref="RollingFile" />
        </root>
    </log4net>
</configuration>
